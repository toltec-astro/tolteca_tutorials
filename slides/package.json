{
  "name": "tolteca-design-slides",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "marp --config-file marp.config.mjs",
    "pdf": "marp --config-file marp.config.mjs --pdf",
    "preview": "python3 -m http.server 8871 --bind 127.0.0.1 --directory ..",
    "build:all": "node build-all.mjs",
    "pdf:all": "node build-all.mjs --pdf",
    "preview:all": "python3 preview.py"
  },
  "dependencies": {
    "@marp-team/marp-cli": "4.5.1",
    "@marp-team/marp-core": "5.0.2",
    "@mathjax/mathjax-bbm-font-extension": "4.1.3",
    "@mathjax/mathjax-bboldx-font-extension": "4.1.3",
    "@mathjax/mathjax-dsfont-font-extension": "4.1.3",
    "@mathjax/mathjax-mhchem-font-extension": "4.1.3",
    "@mathjax/src": "4.1.3",
    "beautiful-mermaid": "1.1.3",
    "katex": "0.18.2",
    "shiki": "4.0.2"
  }
}
